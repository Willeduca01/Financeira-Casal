// This is your Prisma schema file for Gestão Financeira Casal
// Configured for Neon (Serverless PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTNER
  ADMIN
}

enum IncomeCategory {
  SALARY
  VR
  VA
  BONUS
  EXTRA
  INVESTMENT
  OTHER
}

enum WalletType {
  FREE        // Carteira Livre (Salário Líquido, Bônus, Renda Extra)
  BENEFITS    // Carteira de Benefícios (VR e VA)
}

enum BenefitType {
  VR          // Vale Refeição
  VA          // Vale Alimentação
}

enum ExpenseCategory {
  HOUSING            // Aluguel, Condomínio
  UTILITIES          // Luz, Água, Gás, Internet
  LOAN_INSTALLMENT   // Parcela de Empréstimo
  FOOD_MARKET        // Mercado do Mês
  FOOD_PROTEIN       // Mistura / Açougue / Proteínas
  SWEETS_SNACKS      // Doces / Padaria / Lanches
  EAT_OUT_DELIVERY   // Restaurante / Delivery / Comer Fora
  WEEKLY_SHOPPING    // Compras da semana / Feira
  LEISURE            // Lazer / Streaming / Cinema
  TRANSPORT          // Combustível / Uber / Transporte
  HEALTH             // Farmácia / Saúde
  SUBSCRIPTION       // Assinaturas fixas
  OTHER              // Outros
}

enum ExpenseType {
  FIXED              // Gastos Fixos (Aluguel, Luz, etc.)
  VARIABLE           // Gastos Variáveis (Mercado, Lazer, etc.)
  LOAN               // Parcela de Empréstimo
}

enum PaymentMethod {
  DEBIT_PIX          // Conta Corrente / Pix / Débito (Carteira Livre)
  VR                 // Vale Refeição (Carteira de Benefícios)
  VA                 // Vale Alimentação (Carteira de Benefícios)
  CREDIT_CARD        // Cartão de Crédito (Impacta Carteira Livre na fatura)
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
}

enum AbatementType {
  REDUCE_TERM        // Reduzir prazo (abater parcelas do final)
  REDUCE_INSTALLMENT // Reduzir valor da próxima parcela / restantes
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  avatar           String?
  role             Role               @default(PARTNER)
  salaryGross      Decimal            @default(0) @db.Decimal(12, 2)
  salaryNet        Decimal            @default(0) @db.Decimal(12, 2)
  vrAmount         Decimal            @default(0) @db.Decimal(12, 2)
  vaAmount         Decimal            @default(0) @db.Decimal(12, 2)
  incomeProportion Decimal            @default(50.0) @db.Decimal(5, 2) // Proporção no orçamento (%)
  pinHash          String?            // Hash seguro do PIN de 4 dígitos via bcryptjs
  passwordHash     String?            // Hash seguro da senha via bcryptjs
  
  incomes          Income[]
  expenses         Expense[]
  amortizations    LoanAmortization[]
  deposits         EmergencyDeposit[]
  creditCards      CreditCard[]
  benefitCards     BenefitCard[]
  installments     CreditCardInstallment[]
  loans            Loan[]
  loanPayments     LoanPayment[]
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model CoupleSettings {
  id                         String   @id @default(cuid())
  coupleName                 String   @default("Finanças do Casal")
  emergencyFundMonthsTarget  Int      @default(6) // 3, 6 ou 12 meses
  user1SalaryProportion      Decimal  @default(50.0) @db.Decimal(5, 2)
  user2SalaryProportion      Decimal  @default(50.0) @db.Decimal(5, 2)
  updatedAt                  DateTime @updatedAt
}

model Income {
  id          String         @id @default(cuid())
  description String
  amountGross Decimal        @db.Decimal(12, 2)
  amountNet   Decimal        @db.Decimal(12, 2)
  category    IncomeCategory
  walletType  WalletType     @default(FREE)
  benefitType BenefitType?
  receivedAt  DateTime
  
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
  
  @@index([userId])
  @@index([receivedAt(sort: Desc)])
}

model Expense {
  id                     String          @id @default(cuid())
  description            String
  amount                 Decimal         @db.Decimal(12, 2)
  date                   DateTime
  category               ExpenseCategory
  expenseType            ExpenseType
  paymentMethod          PaymentMethod
  isPaid                 Boolean         @default(true)
  dueDate                DateTime?
  creditCardInvoiceMonth String?         // ex: "2026-10"
  
  loanId                 String?
  loan                   Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
  
  creditCardId           String?
  creditCard             CreditCard?     @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  
  userId                 String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt              DateTime        @default(now())
  
  @@index([date(sort: Desc)])
  @@index([expenseType, date(sort: Desc)])
  @@index([category])
  @@index([userId])
  @@index([creditCardId])
  @@index([loanId])
}

enum LoanPaymentType {
  REGULAR
  EARLY_AMORTIZATION
}

enum LoanStrategy {
  TERM_REDUCTION
  INSTALLMENT_REDUCTION
}

model Loan {
  id                      String             @id @default(cuid())
  title                   String             @default("") // Nome do empréstimo (ex: "Empréstimo Pessoal Nubank")
  institution             String             @default("") // Banco/Financeira (ex: "Nubank")
  profileId               String?            // Responsável do casal ou compartilhado
  profile                 User?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  principalAmount         Decimal            @default(0) @db.Decimal(12, 2) // Valor original contratado
  installmentAmount       Decimal            @default(0) @db.Decimal(12, 2) // Valor atual da parcela
  interestRate            Decimal            @default(0) @db.Decimal(6, 3) // Taxa de juros mensal % a.m.
  totalInstallments       Int                // Total de parcelas do contrato
  paidInstallments        Int                // Parcelas já quitadas
  dueDay                  Int                // Dia do vencimento (1 a 31)
  startDate               DateTime           @default(now())
  status                  LoanStatus         @default(ACTIVE)
  totalSaved              Decimal            @default(0) @db.Decimal(12, 2) // Economia acumulada via antecipações
  currentBalance          Decimal            @default(0) @db.Decimal(12, 2) // Saldo devedor atual
  notes                   String?

  // Compatibilidade legada
  name                    String?
  bank                    String?
  originalAmount          Decimal?           @db.Decimal(12, 2)
  monthlyInterestRate     Decimal?           @db.Decimal(6, 3)
  currentInstallmentAmount Decimal?          @db.Decimal(12, 2)
  
  payments                LoanPayment[]
  amortizations           LoanAmortization[]
  expenses                Expense[]
  
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  
  @@index([interestRate(sort: Desc)])
  @@index([monthlyInterestRate(sort: Desc)])
  @@index([status])
  @@index([profileId])
}

model LoanPayment {
  id                 String                @id @default(cuid())
  loanId             String
  loan               Loan                  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date               DateTime              @default(now())
  type               LoanPaymentType       @default(REGULAR) // REGULAR | EARLY_AMORTIZATION
  strategy           LoanStrategy?         // TERM_REDUCTION | INSTALLMENT_REDUCTION
  installmentsAbated Int                   @default(0)       // Quantidade de parcelas abatidas
  originalValue      Decimal               @db.Decimal(12, 2) // Valor cheio que seria pago sem desconto
  paidValue          Decimal               @db.Decimal(12, 2) // Valor efetivamente pago com desconto no banco
  savedAmount        Decimal               @default(0) @db.Decimal(12, 2) // originalValue - paidValue
  notes              String?
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime              @default(now())

  @@index([loanId])
  @@index([date(sort: Desc)])
}

model LoanAmortization {
  id                       String        @id @default(cuid())
  loanId                   String
  loan                     Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountPaid               Decimal       @db.Decimal(12, 2) // Valor pago na amortização
  interestDiscount         Decimal       @db.Decimal(12, 2) // Desconto de juros obtido
  totalAbated              Decimal       @db.Decimal(12, 2) // amountPaid + interestDiscount
  abatementType            AbatementType // REDUCE_TERM ou REDUCE_INSTALLMENT
  installmentsReduced      Int           @default(0)
  previousInstallmentAmount Decimal?     @db.Decimal(12, 2)
  newInstallmentAmount     Decimal?      @db.Decimal(12, 2)
  date                     DateTime      @default(now())
  
  userId                   String
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes                    String?
  
  @@index([loanId])
  @@index([userId])
  @@index([date(sort: Desc)])
}

model EmergencyFund {
  id                         String             @id @default(cuid())
  currentAmount              Decimal            @default(0) @db.Decimal(12, 2)
  targetMonths               Int                @default(6) // 3, 6, 12 meses
  monthlyLivingCostCalculated Decimal           @default(0) @db.Decimal(12, 2)
  notes                      String?
  updatedAt                  DateTime           @updatedAt
  
  deposits                   EmergencyDeposit[]
}

model EmergencyDeposit {
  id        String        @id @default(cuid())
  fundId    String
  fund      EmergencyFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  date      DateTime      @default(now())
  
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String?
  
  @@index([fundId])
  @@index([userId])
}

model CreditCard {
  id              String                  @id @default(cuid())
  name            String                  // ex: "Santander SX", "Nubank Roxinho"
  bank            String                  // ex: "Santander", "Nubank", "Itaú"
  color           String                  @default("#820AD1")
  lastFourDigits  String?
  totalLimit      Decimal                 @db.Decimal(12, 2) // Limite Máximo Total
  availableLimit  Decimal                 @db.Decimal(12, 2) // Limite Liberado / Disponível
  closingDay      Int                     // Dia de fechamento da fatura
  dueDay          Int                     // Dia de vencimento da fatura
  
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  installments    CreditCardInstallment[]
  expenses        Expense[]
  
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  
  @@index([userId])
}

model CreditCardInstallment {
  id                  String          @id @default(cuid())
  cardId              String
  card                CreditCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description         String          // ex: "Smartphone", "Reforma"
  totalAmount         Decimal         @db.Decimal(12, 2) // Valor total da compra parcelada
  installmentAmount   Decimal         @db.Decimal(12, 2) // Valor de cada parcela mensal
  totalInstallments   Int             // Ex: 8, 5, 6
  currentInstallment  Int             @default(1) // Parcela atual
  category            ExpenseCategory @default(OTHER)
  purchaseDate        DateTime        @default(now())
  
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([cardId])
  @@index([userId])
}

model BenefitCard {
  id             String      @id @default(cuid())
  name           String      // ex: "Flash Benefícios", "Sodexo VR", "Alelo VA"
  type           BenefitType // VR ou VA
  currentBalance Decimal     @default(0) @db.Decimal(12, 2)
  monthlyDeposit Decimal     @default(0) @db.Decimal(12, 2)
  depositDay     Int         @default(1) // Dia do mês da recarga
  color          String      @default("#7A8B68")
  lastFourDigits String?
  
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  @@index([userId])
}

